{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/downloads.html",
      "destination": "/downloads",
      "permanent": true
    },
    {
      "source": "/updates.html",
      "destination": "/updates",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/downloads",
      "destination": "/downloads.html"
    },
    {
      "source": "/updates",
      "destination": "/updates.html"
    }
  ]
}